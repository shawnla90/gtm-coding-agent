# Names only. Put real values in a chmod 600 file that git does not track.
# HUBSPOT_ALLOW_CLIENT_PORTAL is the placeholder for HUBSPOT_ALLOW_<CLIENT>_PORTAL.
# The code treats the flag as on only when the value is the exact string true.

HUBSPOT_ALLOW_CLIENT_PORTAL=
HUBSPOT_PORTAL_ID=
HUBSPOT_ACCESS_TOKEN=
INSTANTLY_API_KEY=
INSTANTLY_REPLY_TEST_MODE=true
# Used only while INSTANTLY_REPLY_TEST_MODE=true. Campaigns whose names contain
# this string are skipped: thread hidden, Send blocked, poll and webhook ignored.
# When test mode is false the string is ignored, even if a live campaign contains it.
INSTANTLY_TEST_CAMPAIGN_GUARD=CAMPAIGN_NAME_GUARD
INSTANTLY_CAMPAIGN_IDS=
INSTANTLY_CAMPAIGN_DEAL_PREFIXES=
HUBSPOT_MQL_PIPELINE_ID=
HUBSPOT_MQL_STAGE_ID=
INSTANTLY_WEBHOOK_SECRET=
CRON_SECRET=
# Copy from the app Auth tab into the Vercel dashboard. Do not fill this from
# `vercel env pull`. Sensitive values come back empty or as the literal [SENSITIVE].
HUBSPOT_APP_SECRET=
# A full email, or @client-domain.com for every logged-in user on that domain.
HUBSPOT_REPLY_ALLOWLIST=@client-domain.com
