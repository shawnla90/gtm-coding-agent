# Apollo API key -- get yours at https://app.apollo.io/settings/integrations/api
# This file is a TEMPLATE. Copy it to .env and paste your key.
#   cp .env.example .env
# .env is gitignored and never committed. If `git log --all -p | grep APOLLO`
# returns anything, you have a problem.
APOLLO_API_KEY=your_api_key_here
