# Moltsets API key -- get yours at https://app.moltsets.com (Settings -> API keys)
# Apollo key is OPTIONAL; it powers the --apollo employment check.
# This file is a TEMPLATE. Copy it to .env and paste your keys.
#   cp .env.example .env
# .env is gitignored and never committed. If `git log --all -p | grep -i moltsets_api` returns
# anything, you have a problem. Prefer the vault: export SECRETS_DB=~/.gtm-vault/vault.db and
# leave both lines blank; the scripts read secrets(key, value) from there.
MOLTSETS_API_KEY=your_api_key_here
APOLLO_API_KEY=your_api_key_here
